<!-- Added to /var/ossec/etc/ossec.conf on the Wazuh manager.
     Forwards every alert of level 6+ to the Shuffle webhook as JSON.
     Shuffle filters again (level 7+) before creating TheHive alerts.
     Apply with: sudo systemctl restart wazuh-manager -->
<integration>
  <name>shuffle</name>
  <hook_url>http://<SHUFFLE_IP>:3001/api/v1/hooks/webhook_<WEBHOOK_ID></hook_url>
  <level>6</level>
  <alert_format>json</alert_format>
</integration>
